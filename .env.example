# Public, client-safe Supabase config. These ship inside the app bundle —
# every table is protected by row level security on the assumption that
# anyone can read these values.
#
# NEVER put the service_role key here. It bypasses RLS entirely and belongs
# only in Edge Function secrets.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_YOUR_KEY
