{
  "buildCommand": "./scripts/build-web.sh",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!version\\.json).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    }
  ]
}
